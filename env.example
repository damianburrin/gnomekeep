# Railway / Render: set these as environment variables.
PORT=8080
# HTTPS frontend origins, comma-separated. Required for public deployment.
ALLOWED_ORIGINS=https://your-gnomekeep-site.example
# Where your existing PHP site lives. Server uses signed REST requests.
LEADERBOARD_ENDPOINT=https://your-gnomekeep-site.example/api/submit_online_match.php
# Same value as api/config.php multiplayer_secret; generate 32+ random bytes.
SCORE_API_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_SECRET
# OPTIONAL, for host-only Golden Portal QA. All test matches are unranked.
# ENABLE_PORTAL_TEST=true
